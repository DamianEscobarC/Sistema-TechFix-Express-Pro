@model IEnumerable<Sistema_TechFix_Express_Pro.Models.OrdenServicio>

@{
    ViewData["Title"] = "Órdenes de Servicio - TechFix Express Pro";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">TechFix Express Pro - Gestión de Órdenes</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Nueva Orden de Servicio
        </a>
    </div>

    <!-- Tarjetas KPI -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-start border-primary border-4 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold">Total de Órdenes Registradas</h6>
                    <h2 class="fw-bold mb-0">@Model.Count()</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-start border-success border-4 shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase fw-semibold">Monto Total Presupuestado</h6>
                    <h2 class="fw-bold text-success mb-0">@Model.Sum(o => o.CostoEstimado).ToString("C0")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Órdenes -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>N° Orden</th>
                            <th>Cliente</th>
                            <th>Categoría</th>
                            <th>Técnico Asignado</th>
                            <th>Ingreso</th>
                            <th>Presupuesto</th>
                            <th>Garantía</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string badgeClass = item.Estado switch
                            {
                                "Pendiente" => "bg-warning text-dark",
                                "En Reparacion" => "bg-primary",
                                "Listo" => "bg-success",
                                "Entregado" => "bg-secondary",
                                _ => "bg-dark"
                            };

                            <tr>
                                <td class="fw-bold">@item.NumeroOrden</td>
                                <td>
                                    <div>@item.NombreCliente</div>
                                    <small class="text-muted">@item.TelefonoCliente</small>
                                </td>
                                <td>@item.Categoria?.Nombre</td>
                                <td>@item.Tecnico?.NombreCompleto</td>
                                <td>@item.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@item.CostoEstimado.ToString("C0")</td>
                                <td>
                                    @if (item.TieneGarantia)
                                    {
                                        <span class="badge bg-info text-dark">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @badgeClass">@item.Estado</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>